# Copy to cluster.local.env and adjust only the site-specific lines there.
# A compiled MOOSE installation with solid_mechanics, MPI and PETSc/Hypre is required.
CLUSTER="${CLUSTER:-cx3}"                 # cx3 (default) or hx1
MOOSE_ENV="${MOOSE_ENV:-}"               # optional shell activation file
MOOSE_DIR="${MOOSE_DIR:-$HOME/projects/moose}"
MPI_KIND="${MPI_KIND:-auto}"             # auto, openmpi, intel or mpich
MPIEXEC="${MPIEXEC:-mpirun}"
MPI_SOCKETS_PER_NODE="${MPI_SOCKETS_PER_NODE:-2}" # CX3 Ice Lake has two sockets
NCPUS_PER_NODE="${NCPUS_PER_NODE:-64}"    # reserve whole physical nodes
CPU_TYPE="${CPU_TYPE:-icelake}"          # CX3 only; keep hardware fixed
MEM_GB_PER_NODE="${MEM_GB_PER_NODE:-256}"
WALLTIME="${WALLTIME:-02:00:00}"
BUILD_JOBS="${BUILD_JOBS:-8}"
REPEATS="${REPEATS:-3}"
# For modules/activation, put the commands in cluster.local.env, for example:
# module purge
# module load <the GCC/OpenMPI toolchain used to build your MOOSE installation>
# export MOOSE_DIR=/path/to/that/moose
# Do not load an unrelated MPI after building MOOSE.
